  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Validaciones comunes a TODOS los requests de la colección: tiempo, cabeceras y cuerpo.",
          "// Se suman a las aserciones propias de cada request (código HTTP y datos).",
          "pm.test('Tiempo de respuesta menor a 3000 ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});",
          "",
          "pm.test('Cabecera Content-Type: application/json (o cuerpo vacío en 204)', function () {",
          "    if (pm.response.code === 204) {",
          "        pm.expect(pm.response.text()).to.equal('');",
          "        return;",
          "    }",
          "    pm.response.to.have.header('Content-Type');",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "pm.test('El cuerpo es JSON válido', function () {",
          "    if (pm.response.code === 204) { return; }",
          "    pm.expect(function () { pm.response.json(); }).to.not.throw();",
          "});"
        ]
      }
    }
  ]
