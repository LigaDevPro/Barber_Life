# Email: usar las credenciales SMTP de Mailtrap (sandbox) o de un SMTP real.
# Sin EMAIL_HOST y con DEBUG=True los mails se imprimen en la consola del backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Barber Life <no-reply@barberlife.local>

# Login con Google: Client ID de Google Cloud Console (Credenciales > ID de cliente de OAuth > Aplicación web)
GOOGLE_CLIENT_ID=
