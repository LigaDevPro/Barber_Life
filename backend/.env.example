DEBUG=False
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Producción (Railway u otra plataforma con HTTPS) ---
# ALLOWED_HOSTS: dominio público del backend, ej: mi-api.up.railway.app
# CORS_ALLOWED_ORIGINS: dominio del frontend ej: https://mi-app.vercel.app
# CSRF_TRUSTED_ORIGINS: orígenes https que pueden hacer POST con cookies (admin): backend y frontend.
CSRF_TRUSTED_ORIGINS=
# FRONTEND_URL: a dónde vuelve Mercado Pago al terminar el pago.
FRONTEND_URL=http://localhost:4200
# BACKEND_PUBLIC_URL: URL pública del backend, para el webhook de Mercado Pago.
BACKEND_PUBLIC_URL=

POSTGRES_DB=barberlife
POSTGRES_USER=barberlife
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=barberlife_nosql

CANCELACION_LIMITE_HORAS=2

MERCADOPAGO_ACCESS_TOKEN=

# Email: usar las credenciales SMTP de Mailtrap (sandbox) o de un SMTP real.
# Sin EMAIL_HOST y con DEBUG=True los mails se imprimen en la consola del backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Barber Life <no-reply@barberlife.local>

# Login con Google: Client ID de Google Cloud Console (Credenciales > ID de cliente de OAuth > Aplicación web)
GOOGLE_CLIENT_ID=
