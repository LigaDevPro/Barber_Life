{
  "info": {
    "name": "Barber Life - API 2: Catálogo y Turnos",
    "description": "Servicios, horarios, oferta barbero-servicio y ciclo de vida de turnos (reserva, solapamiento, pasado, estado, cancelación). Autocontenida: hace su propio setup y limpia al final. Requiere seed_demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Setup (usuarios y tokens)",
      "item": [
        {
          "name": "Setup: Registro cliente OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Mensaje de cuenta creada\", () => pm.expect(pm.response.json().detail).to.include(\"Cuenta creada\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set(\"emailCliente\", `cliente.${ts}@mail.com`);",
                  "pm.collectionVariables.set(\"passCliente\", \"Cliente#2026x\");",
                  "const d = new Date(); d.setDate(d.getDate() + 3);",
                  "pm.collectionVariables.set(\"fechaTurno\", d.toISOString().slice(0,10));",
                  "pm.collectionVariables.set(\"diaSemana\", String(d.getDay() === 0 ? 7 : d.getDay()));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"{{emailCliente}}\",\n  \"password\": \"{{passCliente}}\",\n  \"password_confirm\": \"{{passCliente}}\"\n}"
            }
          }
        },
        {
          "name": "Setup: Login cliente OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve access, refresh y usuario\", () => { pm.expect(j).to.have.keys(\"access\",\"refresh\",\"usuario\"); });",
                  "pm.test(\"Rol cliente\", () => pm.expect(j.usuario.rol).to.eql(\"cliente\"));",
                  "pm.collectionVariables.set(\"tokenCliente\", j.access);",
                  "pm.collectionVariables.set(\"refreshCliente\", j.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"{{emailCliente}}\",\n  \"password\": \"{{passCliente}}\"\n}"
            }
          }
        },
        {
          "name": "Setup: Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Rol admin\", () => pm.expect(j.usuario.rol).to.eql(\"admin\"));",
                  "pm.collectionVariables.set(\"tokenAdmin\", j.access);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
